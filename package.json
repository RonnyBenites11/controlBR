{
  "name": "baby-ronnys",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "overrides": {
    "glob": "^14.0.5",
    "minimatch": "^11.0.8"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "icons": "node scripts/generate-icons.mjs",
    "manual:pdf": "node scripts/generate-user-manual.mjs",
    "format": "prettier --write src tests scripts *.ts *.js *.json *.md supabase .github public/_headers public/_redirects --ignore-unknown",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "node scripts/test-database.mjs",
    "test:e2e": "playwright test",
    "test:production": "node scripts/verify-production.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "browser-image-compression": "^2.0.2",
    "jsbarcode": "^3.12.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pg": "^8.16.3",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.1.0"
  }
}
